#!/usr/bin/env python3
import json, os, sys
p=os.path.join(os.getcwd(),'.eval','state.json'); s=json.load(open(p)); a=sys.argv[1:]; s['calls'].append('gh '+' '.join(a))
def val(flag, default=''):
 return a[a.index(flag)+1] if flag in a and a.index(flag)+1<len(a) else default
if a[:2]==['repo','view']: print('{"defaultBranchRef":{"name":"main"}}')
elif a[:2]==['api','user']: print('orbit-dev' if '--jq' in a else '{"login":"orbit-dev"}')
elif a[:2]==['pr','view']:
 if s['pr']: print(json.dumps(s['pr']))
 else: print('no pull requests found',file=sys.stderr); json.dump(s,open(p,'w'),indent=2); sys.exit(1)
elif a[:2]==['pr','create']:
 body=val('--body');
 if not body and '--body-file' in a: body=open(val('--body-file')).read()
 assignee=val('--assignee')
 s['pr']={'url':'https://github.test/orbit/mobile/pull/88','baseRefName':val('--base'),'headRefName':s['bookmark'],'title':val('--title'),'body':body,'assignees':[assignee] if assignee else []}
 print(s['pr']['url'])
elif a[:2]==['pr','edit']:
 if '--add-assignee' in a and s['pr']: s['pr']['assignees'].append(val('--add-assignee'))
 if '--body' in a and s['pr']: s['pr']['body']=val('--body')
 print(s['pr']['url'] if s['pr'] else '')
elif a[:2]==['pr','list']: print('[]')
else: print('{}')
json.dump(s,open(p,'w'),indent=2)
